{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"],
    // Path values are relative to this file's own directory, so no "baseUrl" is
    // needed to anchor them. TypeScript 7 drops "baseUrl" entirely; this form
    // resolves identically on 5.x and 7.x.
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/core/**/*",
    "src/server/**/*",
    "src/session-host/**/*",
    // The Android interop fixture runs the desktop's real host code and implements its interfaces
    // (HostPtyManager, the kanban/inbox/nodeActions bridge). esbuild only strips its types, and the
    // Android workflow runs no tsc, so `npm run typecheck` (every CI run) is what catches a desktop
    // change that breaks it (audit A67).
    "android/protocol/src/test/interop/**/*.ts"
  ]
}
